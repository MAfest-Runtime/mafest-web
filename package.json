{
  "name": "mafest-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "fonts:generate": "node scripts/generate-font-css.mjs && prettier --write src/styles/fonts.css"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.18.4",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1"
  }
}
